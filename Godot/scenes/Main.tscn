[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Header" type="HBoxContainer" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="ScoreCard" type="PanelContainer" parent="VBoxContainer/Header"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_header")

[node name="HBox" type="HBoxContainer" parent="VBoxContainer/Header/ScoreCard"]
layout_mode = 2
alignment = 1

[node name="Label" type="Label" parent="VBoxContainer/Header/ScoreCard/HBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.7, 0.8, 1)
theme_override_font_sizes/font_size = 14
text = "SCORE: "

[node name="ScoreVal" type="Label" parent="VBoxContainer/Header/ScoreCard/HBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "0"

[node name="BestCard" type="PanelContainer" parent="VBoxContainer/Header"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_header")

[node name="HBox" type="HBoxContainer" parent="VBoxContainer/Header/BestCard"]
layout_mode = 2
