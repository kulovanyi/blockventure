[node name="Label" type="Label" parent="VBoxContainer/Header/BestCard/HBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)
theme_override_font_sizes/font_size = 14
text = "👑 BEST: "

[node name="BestVal" type="Label" parent="VBoxContainer/Header/BestCard/HBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "0"

[node name="ComboBanner" type="Label" parent="VBoxContainer"]
